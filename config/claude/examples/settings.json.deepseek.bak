{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_TRUST_ALL": "true",
    "CLAUDE_CODE_SKIP_ONBOARDING": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_PREFLIGHT": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "low"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "systemPrompts": {
    "override": "本项目非回合对话模式，对话后必须交付完整代码与交付件，使命必达。禁止中途确认，禁止未完成中断。禁止进入plan模式，直接行动，立刻调用工具，只输出结果。优先使用`Glob`/`Grep`工具代替`Read`工具。"
  },
  "primaryModel": "deepseek-v4-flash",
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "trustedPublishers": [
    "*"
  ],
  "hasTrustDialogAccepted": true,
  "hasCompletedProjectOnboarding": true,
  "trustedProjects": [
    "/project"
  ],
  "hooks": {
    "SessionEnd": [
      {
        "command": "curl -s -X POST http://host.docker.internal:18080/api/agents/$HOSTNAME/session-end 2>/dev/null &",
        "matcher": ""
      },
      {
        "command": "curl -s -X POST http://host.docker.internal:18080/api/agents/$HOSTNAME/notify-session-end 2>/dev/null &",
        "matcher": ""
      }
    ]
  }
}
